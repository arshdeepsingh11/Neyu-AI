{
  "appId": "com.neyuhealth.app",
  "appName": "NEYU",
  "webDir": "www",
  "backgroundColor": "#F7F6F2",
  "appendUserAgent": "NeyuApp/1",
  "server": {
    "url": "https://neyuhealth.com/app-start",
    "cleartext": false,
    "allowNavigation": [
      "neyuhealth.com",
      "*.neyuhealth.com"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "appendUserAgent": "NeyuApp/1"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "appendUserAgent": "NeyuApp/1 NeyuPush/1"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1200,
      "backgroundColor": "#F7F6F2",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#F7F6F2"
    }
  }
}
