      "item": [
        {
          "name": "Admin sign in · step 1 (email + password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('asks for the 2-step code (not first-time setup)', () => {",
                  "  if (j.step === 'setup') throw new Error('2-step is not set up yet: sign in once at /admin in the browser and scan the QR code first.');",
                  "  pm.expect(j.step).to.eql('code');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
