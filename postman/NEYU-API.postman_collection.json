        {
          "name": "Admin sign in · step 2 (2-step code)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Makes the 6-digit code from totpSecret (the key shown under 'Can't scan? Type this key' when you set up 2-step).",
                  "const secret = String(pm.variables.get('totpSecret') || '').replace(/\\s/g, '').toUpperCase();",
                  "if (!secret) throw new Error('Set totpSecret (your 2-step key) — see the collection description.');",
                  "const A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'; let bits = '';",
                  "for (const ch of secret) { const i = A.indexOf(ch); if (i < 0) throw new Error('totpSecret has a wrong character: ' + ch); bits += i.toString(2).padStart(5, '0'); }",
                  "let hex = ''; for (let i = 0; i + 8 <= bits.length; i += 8) hex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
                  "const step = Math.floor(Date.now() / 30000);",
                  "const h = CryptoJS.HmacSHA1(CryptoJS.enc.Hex.parse(step.toString(16).padStart(16, '0')), CryptoJS.enc.Hex.parse(hex)).toString();",
                  "const o = parseInt(h.slice(-1), 16);",
                  "const n = (parseInt(h.substr(o * 2, 8), 16) & 0x7fffffff) % 1000000;",
                  "pm.variables.set('totpCode', String(n).padStart(6, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('signed in as staff', () => pm.expect(pm.response.json().actor).to.eql(pm.variables.get('staffEmail').toLowerCase()));",
                  "// If this fails with 'code isn't right' right after another run: wait 30 seconds (each code works once)."
                ]
              }
            }
          ],
