# Copy this file to .env.local for local development,
# or set these as real environment variables on your production server.

# Gemini API key — used by all 3 AI routes (chat, symptom-check, generate-referral).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY= 


# Super admin (Phase 4) — always works, can't be locked out. Change the password here, then restart.
# SUPER_ADMIN_USERNAME=arsh
# SUPER_ADMIN_PASSWORD=choose-8-or-more-characters
# SUPER_ADMIN_NAME=Arsh Singh
# SUPER_ADMIN_2STEP=off              on = also ask for the authenticator-app code

# Phase 3 (all optional on a laptop):
# REDIS_URL=redis://127.0.0.1:6379   shared limits + background job queue (docker compose runs Redis)
# STORAGE_DIR=./storage              where report files are kept (encrypted). Default ./storage
# RUN_WORKER=1                       background worker inside the website (default on)

# Phase 5 (optional):
# METRICS_TOKEN=                     turns on /api/v1/metrics for a monitoring system (16+ characters)

# Phase 6 — push notifications to the NEYU phone app (optional; without them nothing is sent):
# FIREBASE_SERVICE_ACCOUNT=          Android: Firebase service-account JSON (one line, or base64)
# APNS_KEY=                          iPhone: the .p8 key text (or base64) from developer.apple.com → Keys
# APNS_KEY_ID=                       the key's 10-character id
# APNS_TEAM_ID=                      your Apple Team ID
# APNS_ENV=development               development for Xcode test builds; production (default in production) for TestFlight / App Store
