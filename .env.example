# Copy this file to .env.local for local development,
# or set these as real environment variables on your production server.

# Gemini API key — used by all 3 AI routes (chat, symptom-check, generate-referral).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY= 


# Phase 3 (all optional on a laptop):
# REDIS_URL=redis://127.0.0.1:6379   shared limits + background job queue (docker compose runs Redis)
# STORAGE_DIR=./storage              where report files are kept (encrypted). Default ./storage
# RUN_WORKER=1                       background worker inside the website (default on)
