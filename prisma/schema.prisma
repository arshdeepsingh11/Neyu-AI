generator client {
  provider = "prisma-client-js"
}

// NEYU Platform — schema v2 (PostgreSQL). See NEYU-System-Design-v2.pdf.
// Existing models keep their names so the app keeps working; the foundation
// models (organizations, staff + roles, consent, audit, deletion, reports) are
// added at the end and are wired into features in Phase 3.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Anonymous site activity (existing). `patientId` is filled automatically
// when the visitor is signed in to My Health Space, so their History tab
// can show it. Nullable: anonymous visitors keep working exactly as before.
// ─────────────────────────────────────────────────────────────────────────

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  sessionId String
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([sessionId])
  @@index([createdAt(ops: TimestampMinMaxOps)], type: Brin) // tiny index for time-range scans + retention deletes
}

model ReferralSubmission {
  id                 String    @id @default(cuid())
  type               String
  patientName        String?
  patientPhone       String?
  referringPhysician String?
  referringPhone     String?
  referringAddress   String?
  urgency            String?
  specialties        String?
  physicianSlugs     String?
  exams              String?
  clinicalNotes      String?
  sourceText         String?
  sessionId          String
  createdAt          DateTime  @default(now())
  // My Health Space
  patientId          String?
  patient            Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  status             String    @default("received") // received | reviewed | scheduled | closed
  reviewedAt         DateTime?
  reviewedBy         String?
  scheduledAt        DateTime?
  staffNote          String?

  orgId String @default("org_neyu")

  @@index([sessionId])
  @@index([status, createdAt])
  @@index([patientId, createdAt])
  @@index([orgId, status, createdAt])
}

model SymptomCheckLog {
  id                    String    @id @default(cuid())
  specialty             String
  description           String
  emergency             Boolean
  urgency               String
  recommendedDiscipline String
  summary               String
  sessionId             String
  createdAt             DateTime  @default(now())
  patientId             String?
  patient               Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  reviewedAt            DateTime? // admin console: emergency queue
  reviewedBy            String?

  @@index([sessionId])
  @@index([patientId, createdAt])
  @@index([emergency, reviewedAt])
}

model AlbaConversation {
  id          String        @id @default(cuid())
  sessionId   String
  pageContext String?
  createdAt   DateTime      @default(now())
  messages    AlbaMessage[]
  patientId   String?
  patient     Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([patientId, createdAt])
}

model AlbaMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   AlbaConversation @relation(fields: [conversationId], references: [id])
  role           String
  text           String
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model LongevityAssessment {
  id                String   @id @default(cuid())
  answers           String
  summary           String
  focusAreas        String
  suggestedNextStep String
  sessionId         String
  createdAt         DateTime @default(now())
  patientId         String?
  patient           Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([patientId, createdAt])
}

model LabResultCheck {
  id             String   @id @default(cuid())
  inputType      String
  overallSummary String
  results        String
  sessionId      String
  createdAt      DateTime @default(now())
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([patientId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// My Health Space — patient accounts and health data.
// Real patient data must not go live before the Alberta HIA Privacy Impact
// Assessment clears (see .env PORTAL_SIGNUP_OPEN).
// JSON-in-text fields stay String for now (parsed in backend/patientData.ts);
// new tables use native Json (jsonb).
// ─────────────────────────────────────────────────────────────────────────

model Patient {
  id              String       @id @default(cuid())
  email           String       @unique // always stored lower-cased
  passwordHash    String // scrypt$N$r$p$salt$hash
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  phone           String?
  timezone        String       @default("America/Edmonton")
  photoVersion    Int          @default(0) // > 0 = has photo (URL version); ≤ 0 = none. Only ever grows in magnitude (cache-busting)
  termsAcceptedAt DateTime
  emailVerifiedAt DateTime? // null until the 6-digit email code is confirmed
  lastLoginAt     DateTime?
  failedLogins    Int          @default(0)
  lockedUntil     DateTime?
  accountStatus   String       @default("active") // active | deactivated | deletion_requested (set by the clinic)
  orgId           String       @default("org_neyu")
  org             Organization @relation(fields: [orgId], references: [id])
  deletedAt       DateTime? // set when a deletion request is executed (row kept only as a stub)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions         PatientSession[]
  emailCodes       EmailCode[]
  photo            PatientPhoto?
  settings         PatientSettings?
  goals            Goal[]
  careTeam         CareTeamMember[]
  devices          DeviceConnection[]
  pairings         DevicePairing[]
  readings         HealthReading[]
  labResults       LabResult[]
  protocolItems    ProtocolItem[]
  protocolLogs     ProtocolLog[]
  appointments     Appointment[]
  visitQuestions   VisitQuestion[]
  accessLogs       AccessLog[]
  referrals        ReferralSubmission[]
  symptomChecks    SymptomCheckLog[]
  conversations    AlbaConversation[]
  assessments      LongevityAssessment[]
  labChecks        LabResultCheck[]
  visitors         Visitor[]
  bpReadings       BpReading[]
  lifestyleLogs    LifestyleLog[]
  careGiven        CareLink[]            @relation("CareOwner")
  careReceived     CareLink[]            @relation("CareGiver")
  shareLinks       ShareLink[]
  challengesMade   Challenge[]
  challengeJoins   ChallengeMember[]
  rewardEvents     RewardEvent[]
  notes            GeneratedNote[]
  healthProfile    HealthProfile?
  documents        HealthDocument[]
  foodLogs         FoodLog[]
  activity         ActivityEvent[]
  checkIns         HealthCheckIn[]
  insights         HealthInsight[]
  profileChanges   ProfileChange[]
  consents         Consent[]
  emailPreference  EmailPreference?
  guardianOf       GuardianLink[]        @relation("Guardian")
  guardedBy        GuardianLink[]        @relation("Ward")
  deletionRequests DeletionRequest[]
  exportRequests   ExportRequest[]
  reports          PatientReport[]

  @@index([orgId, createdAt])
  @@index([accountStatus])
}

// Only a SHA-256 hash of the session token is stored — a leaked database
// can't be used to hijack a session.
model PatientSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([patientId])
  @@index([expiresAt])
}

// One-time 6-digit email codes (verification now; password reset later).
// Only a SHA-256 of the code is stored. 10-minute expiry, 5 attempts.
model EmailCode {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose   String // verify
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId, purpose, createdAt])
}

// Kept out of Patient so profile reads never load image bytes.
model PatientPhoto {
  patientId String   @id
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

// Consents (Privacy & Data) + notification preferences — one row per patient.
model PatientSettings {
  patientId       String   @id
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  shareWearables  Boolean  @default(true)
  shareLabs       Boolean  @default(true)
  shareRecords    Boolean  @default(true)
  albaAccess      Boolean  @default(true)
  notifDaily      Boolean  @default(true)
  notifWorth      Boolean  @default(true)
  notifProtocol   Boolean  @default(true)
  notifAppt       Boolean  @default(true)
  // Health Universe
  city            String? // "Calgary" — for the daily brief (weather + air quality)
  province        String? // "AB"
  lat             Float?
  lon             Float?
  briefEmail      Boolean  @default(false) // email the ANRA Today brief each morning
  learnUsage      Boolean  @default(true)
  aiInsights      Boolean  @default(true) // Neyu notices changes and shows insights proactively // Neyu learns from which screens / actions the patient uses
  leaderboardName String? // shown in challenges ("Arsh S."); null = first name + initial
  updatedAt       DateTime @updatedAt
}

model Goal {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([patientId])
}

// Added by the clinic. physicianSlug links to src/data/physicians.ts.
model CareTeamMember {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name          String
  role          String
  physicianSlug String?
  location      String?
  createdAt     DateTime @default(now())

  @@index([patientId])
}

// provider: apple | oura | whoop | garmin | gfit
// status: pending (token issued, waiting for first sync) | connected | disconnected
model DeviceConnection {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider        String
  status          String    @default("pending")
  tokenHash       String?   @unique // SHA-256 of the device ingest token
  tokenHint       String? // last 4 chars, for display only
  dataTypes       String    @default("[]") // JSON array of shared metric keys
  // OAuth sources (Oura, Withings, WHOOP…): tokens are AES-256-GCM encrypted
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  externalUserId  String?
  lastError       String?
  connectedAt     DateTime?
  lastSyncAt      DateTime?
  lastAttemptAt   DateTime? // every ingest call, even when nothing was stored
  lastResult      String? // JSON: { stored, metrics[], rejected[] } of the last attempt
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([patientId, provider])
}

// One value per patient + metric + day + source. `day` is YYYY-MM-DD in
// the patient's timezone, so charts never need timezone math at read time.
// metric keys: see src/lib/portal/metrics.ts (METRIC_DEFS).
model HealthReading {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metric     String
  day        String
  value      Float
  valueText  String? // e.g. ECG classification, blood pressure "118/76"
  source     String // apple | oura | ... | clinic | manual
  recordedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([patientId, metric, day, source])
  @@index([patientId, metric, day])
}

// status: final | pending. Written by the clinic / BioAro Labs integration.
model LabResult {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code        String // stable test key, e.g. "ldl", "hba1c" — groups history
  name        String
  fullName    String?
  category    String // Heart Health | Metabolic Health | Inflammation | Nutrition | Hormones | Genomics | Other
  value       Float?
  valueText   String?
  unit        String?
  refLow      Float?
  refHigh     Float?
  refText     String?
  status      String    @default("final")
  expectedAt  DateTime?
  collectedAt DateTime?
  source      String    @default("BioAro Labs")
  panel       String?
  about       String? // "What is this?"
  guidance    String? // "What should I know?"
  staffNote   String? // clinic-only note, never shown to the patient
  documentId  String? // set when the value came from a patient-added report (HealthDocument)
  createdAt   DateTime  @default(now())

  @@index([patientId, code, collectedAt])
  @@index([patientId, collectedAt])
  @@index([documentId])
}

model ProtocolItem {
  id        String        @id @default(cuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  slot      String // Morning | Midday | Evening
  timeOfDay String? // "09:10" — shown on the Today timeline
  dose      String
  source    String // BioAro Drugs | Care plan | …
  sections  String        @default("[]") // JSON [{h,t}]
  guidance  String?
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  startedAt DateTime      @default(now())
  pausedAt  DateTime? // paused by the clinic (active = false while paused)
  endedAt   DateTime?
  createdAt DateTime      @default(now())
  logs      ProtocolLog[]

  @@index([patientId, active])
}

model ProtocolLog {
  id        String       @id @default(cuid())
  itemId    String
  item      ProtocolItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD, patient timezone
  doneAt    DateTime     @default(now())

  @@unique([itemId, day])
  @@index([patientId, day])
}

// status: scheduled | completed | cancelled
model Appointment {
  id                    String          @id @default(cuid())
  patientId             String
  patient               Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title                 String
  clinician             String
  location              String
  startsAt              DateTime
  durationMin           Int             @default(30)
  status                String          @default("scheduled")
  summaryAvailable      Boolean         @default(false)
  rescheduleRequestedAt DateTime?
  prepShareTrends       Boolean         @default(true)
  prepShareResults      Boolean         @default(true)
  prepShareSymptoms     Boolean         @default(true)
  prepSavedAt           DateTime?
  prepReviewedAt        DateTime? // admin console: visit-prep queue
  staffNotes            String?
  orgId                 String          @default("org_neyu")
  createdAt             DateTime        @default(now())
  questions             VisitQuestion[]

  @@index([patientId, startsAt])
  @@index([orgId, startsAt])
}

// "Questions to ask" — kept even before an appointment exists; attached to
// the next appointment when the patient saves their visit preparation.
model VisitQuestion {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  text          String
  createdAt     DateTime     @default(now())

  @@index([patientId, createdAt])
}

// Audit trail of every read/write of patient data (HIA requirement).
// actor: patient | admin | device
model AccessLog {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  actor     String
  action    String // read | create | update | delete | login | logout | export
  resource  String
  ip        String?
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Admin console
// ─────────────────────────────────────────────────────────────────────────

// Every browser gets an anonymous visitor record (keyed by the
// anra_session_id cookie) with a short public ID shown to staff, e.g.
// "v_7Q2K9X". The cookie value itself is never shown. When the visitor
// signs up or signs in to My Health Space, patientId is set and their
// anonymous activity is merged into the patient record.
model Visitor {
  id          String    @id // public ID: v_XXXXXX
  sessionId   String    @unique
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  pageCount   Int       @default(0)
  landingPath String?
  referrer    String?
  userAgent   String?
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  convertedAt DateTime?

  @@index([patientId])
  @@index([lastSeenAt])
}

// Links from anrahealth.ca / My Health Space to other sites (clicks only).
model OutboundClick {
  id        String   @id @default(cuid())
  sessionId String
  host      String
  url       String
  fromPath  String?
  createdAt DateTime @default(now())

  @@index([createdAt(ops: TimestampMinMaxOps)], type: Brin)
  @@index([host, createdAt])
}

// Append-only staff audit trail (Alberta HIA). Covers events with and
// without a patient (sign-ins, visitor views, exports). Patient-related
// events are also mirrored into that patient's AccessLog.
// kind: View | Reveal | Change | Export | Account
model AdminAuditEvent {
  id          String   @id @default(cuid())
  actor       String // staff identifier typed at sign-in (shared password in Phase 1)
  role        String   @default("Admin (shared)")
  kind        String
  action      String
  resource    String
  subjectType String? // patient | visitor | referral
  subjectId   String?
  subject     String? // display label at the time of the event
  reason      String?
  before      String?
  after       String?
  ip          String?
  result      String   @default("Success") // Success | Denied
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([subjectId, createdAt])
  @@index([kind, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Health Universe (My Health Space): home blood pressure, lifestyle
// check-ins, family care, share-with-my-doctor links, challenges, rewards,
// and cached AI text (daily brief, monthly story).
// ─────────────────────────────────────────────────────────────────────────

// Every home BP reading (several a day). The daily average also goes to
// HealthReading (metric "bp") so Trends and ALBA see it.
model BpReading {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sys       Int
  dia       Int
  pulse     Int?
  takenAt   DateTime
  day       String // YYYY-MM-DD, patient timezone
  source    String   @default("manual") // manual | withings | import
  note      String?
  createdAt DateTime @default(now())

  @@unique([patientId, takenAt, source])
  @@index([patientId, day])
}

// Water, caffeine, alcohol (counts), mood and stress (1–5), meals (text).
model LifestyleLog {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // water | caffeine | alcohol | mood | stress | meal
  value     Float
  note      String?
  day       String
  at        DateTime @default(now())

  @@index([patientId, day])
  @@index([patientId, kind, day])
}

// A caregiver (family member) who can view a patient's summary.
// Created by the patient (owner); accepted by the caregiver's own account.
model CareLink {
  id          String    @id @default(cuid())
  ownerId     String
  owner       Patient   @relation("CareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  caregiverId String?
  caregiver   Patient?  @relation("CareGiver", fields: [caregiverId], references: [id], onDelete: Cascade)
  email       String // invited email (lower-case)
  relation    String    @default("Family")
  status      String    @default("pending") // pending | active | revoked
  inviteHash  String?   @unique
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([ownerId])
  @@index([caregiverId])
}

// Read-only link for a clinician. Only the SHA-256 of the token is stored.
model ShareLink {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  label        String
  scope        String    @default("[]") // JSON: trends | bp | labs | lifestyle
  expiresAt    DateTime
  revokedAt    DateTime?
  views        Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([patientId])
}

model Challenge {
  id          String            @id @default(cuid())
  code        String            @unique // join code, e.g. "K7Q2MX"
  name        String
  metric      String // steps | active | water | protocol
  goal        Float // daily goal
  startDay    String
  endDay      String
  org         String? // company / team name
  createdById String
  createdBy   Patient           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  members     ChallengeMember[]
}

model ChallengeMember {
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@id([challengeId, patientId])
  @@index([patientId])
}

// Points ledger. Earned rows are unique per kind per day (idempotent);
// redemptions are negative and carry the BioAro discount code.
model RewardEvent {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // checkin | protocol | steps | bp | streak7 | redeem
  day       String
  points    Int
  code      String?  @unique
  note      String?
  createdAt DateTime @default(now())

  @@unique([patientId, kind, day])
  @@index([patientId, createdAt])
}

// Cached generated text: the daily brief (period = day) and the monthly
// health story (period = YYYY-MM). Regenerated when missing.
model GeneratedNote {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // brief | story
  period    String
  body      String // JSON
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([patientId, kind, period])
}

// Patient-entered health baseline (5 sections, all optional). JSON keyed by
// the field keys in src/lib/portal/profileSchema.ts; validated on write.
model HealthProfile {
  patientId String   @id
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}

/// One-time QR pairing: the computer shows a QR, the phone claims it once to
/// receive its private sync link. Only the SHA-256 of the code is stored.
model DevicePairing {
  codeHash  String    @id
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId])
}

// Neyu version: requests from the new service pages (virtual care, Virtual
// Hypertension Clinic, packages / executive health, membership, at-home
// collection). Nothing is booked or charged online; staff follow up.
model ServiceRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  service   String // virtual-care | hypertension-clinic | package | membership | at-home
  choice    String? // visit type / package / tier / tests
  name      String
  email     String
  phone     String?
  postal    String?
  message   String?
  page      String?
  sessionId String?
  status    String   @default("new") // new | contacted | booked | closed
  orgId     String   @default("org_neyu")

  @@index([createdAt])
  @@index([service])
  @@index([orgId, status, createdAt])
}

// Personal Health Space: any report from any provider (upload, scan, photo or
// a connected BioAro service). The original file is never altered; Neyu's
// reading is stored separately (extracted + summary) and labelled as AI.
model HealthDocument {
  id        String          @id @default(cuid())
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  kind      String          @default("other") // lab | imaging | ecg | cardiology | specialist | discharge | prescription | visit | other
  provider  String?
  docDate   DateTime?
  source    String          @default("upload") // upload | scan | photo | bioaro
  mime      String
  fileName  String
  size      Int
  pages     Int             @default(0) // page count of the original (0 = not counted yet)
  data      Bytes
  extracted String          @default("{}") // JSON { values:[{name,value,unit,ref,flag}], keyPoints:[] } — Neyu's reading
  summary   String? // Neyu's plain-language explanation (AI)
  status    String          @default("review") // review | saved | failed
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  reports   PatientReport[]

  @@index([patientId, docDate])
  @@index([patientId, createdAt])
}

model FoodLog {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD in the patient's timezone
  at        DateTime @default(now())
  meal      String // breakfast | lunch | dinner | snack | drink
  text      String
  portion   String? // small | regular | large
  photo     Bytes?
  photoMime String?
  tags      String   @default("[]") // Neyu tags: vegetables, fruit, protein, fibre, whole-grain, processed, sugary, water…
  createdAt DateTime @default(now())

  @@index([patientId, day])
}

// What the patient looks at and does in My Health Space (screen views with
// time spent, button clicks). Only kept while "Neyu learns from my use" is on.
model ActivityEvent {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind      String // view | click
  target    String
  ms        Int      @default(0)
  at        DateTime @default(now())

  @@index([patientId, at])
}

// Weekly Neyu check-in (optional, skippable). 1–5 scales; null = not asked/skipped.
model HealthCheckIn {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD (patient timezone)
  feeling   Int // 1 poor … 5 great
  energy    Int?
  sleep     Int?
  stress    Int?
  activity  Int?
  pain      Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([patientId, day])
}

// Proactive "Neyu noticed" insights. Rules-based and evidence-backed; one per
// (patient, key) so the same change is never shown twice.
model HealthInsight {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  key         String // dedupe key, e.g. "steps:improved:2026-W40"
  status      String // new | improved | worsened | stable | changed | unknown | insufficient
  area        String
  title       String
  text        String
  evidence    String    @default("[]") // JSON Evidence[]
  confidence  String    @default("limited") // strong | limited | insufficient
  go          String?
  createdAt   DateTime  @default(now())
  seenAt      DateTime?
  dismissedAt DateTime?

  @@unique([patientId, key])
  @@index([patientId, createdAt])
}

// What the patient changed in their health profile, and when (for the
// doctor summary: "recent changes in patient profile").
model ProfileChange {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  field     String
  label     String
  oldValue  String?
  newValue  String?
  at        DateTime @default(now())

  @@index([patientId, at])
}

// ═════════════════════════════════════════════════════════════════════════
// FOUNDATION (schema v2) — organizations, staff + roles, compliance, reports.
// Wired into features in Phase 3. Every admin action is permission-checked.
// ═════════════════════════════════════════════════════════════════════════

// NEYU Health itself, partners and any future clinic. Every patient belongs to one.
model Organization {
  id        String   @id @default(cuid()) // "org_neyu" for NEYU Health
  slug      String   @unique
  name      String
  kind      String   @default("clinic") // platform | clinic | partner
  status    String   @default("active") // active | suspended
  settings  Json     @default("{}") // e.g. { reportApproval: "required", reminderDays: 3 }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics     Clinic[]
  patients    Patient[]
  roles       Role[]
  memberships Membership[]
  reports     PatientReport[]
}

model Clinic {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  address   String?
  phone     String?
  fax       String?
  timezone  String       @default("America/Edmonton")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  memberships Membership[]

  @@unique([orgId, slug])
}

// Admin / staff accounts (separate from patients). Passwords: scrypt like patients;
// MFA secret is AES-256-GCM encrypted. Admins must enrol MFA (enforced in Phase 3).
model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique // lower-cased
  name         String
  passwordHash String
  mfaSecretEnc String?
  mfaEnabledAt DateTime?
  status       String    @default("active") // invited | active | suspended
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        StaffSession[]
  memberships     Membership[]
  reportsCreated  PatientReport[] @relation("ReportCreatedBy")
  reportsApproved PatientReport[] @relation("ReportApprovedBy")
}

// Only the SHA-256 of the session token is stored. Admin sessions are short (8 h).
model StaffSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  staffId     String
  staff       StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  mfaVerified Boolean   @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime

  @@index([staffId])
  @@index([expiresAt])
}

// A role is a named set of permissions. orgId = null → built-in role usable by every org.
// New admin types are new rows here — no code change.
model Role {
  id          String        @id @default(cuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String // super_admin | org_admin | clinic_manager | care_staff | physician | support
  name        String
  description String?
  isSystem    Boolean       @default(false) // system roles can't be deleted
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  permissions RolePermission[]
  memberships Membership[]

  @@unique([orgId, key])
}

// Catalogue of every permission the code checks, e.g. "reports.send".
model Permission {
  key         String @id
  area        String // platform | staff | patients | reports | care | analytics | audit | privacy
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  scope         String     @default("full") // full | reason (break-glass: a reason is recorded) | own

  @@id([roleId, permissionKey])
}

// "This person has this role in this organization (optionally one clinic)".
model Membership {
  id        String       @id @default(cuid())
  staffId   String
  staff     StaffUser    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  clinicId  String?
  clinic    Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  status    String       @default("active") // active | suspended
  createdAt DateTime     @default(now())

  @@unique([staffId, orgId, roleId])
  @@index([orgId, status])
}

// Published versions of terms / privacy policy / AI notice / marketing consent text.
model PolicyVersion {
  id          String    @id @default(cuid())
  kind        String // terms | privacy | ai | marketing | guardian
  version     String // "2026-10-15"
  url         String?
  summary     String?
  publishedAt DateTime  @default(now())
  consents    Consent[]

  @@unique([kind, version])
}

// Proof of consent: what, which version, when, how. Withdrawal is a new state, never a delete.
model Consent {
  id              String         @id @default(cuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind            String // terms | privacy | ai | marketing | guardian
  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])
  granted         Boolean
  method          String // signup | settings | guardian | staff
  ip              String?
  userAgent       String?
  createdAt       DateTime       @default(now())
  withdrawnAt     DateTime?

  @@index([patientId, kind, createdAt])
}

// Parent / guardian access to a minor's account. Ends at 18 unless renewed.
model GuardianLink {
  id         String    @id @default(cuid())
  guardianId String
  guardian   Patient   @relation("Guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  wardId     String
  ward       Patient   @relation("Ward", fields: [wardId], references: [id], onDelete: Cascade)
  relation   String    @default("Parent") // Parent | Legal guardian
  status     String    @default("active") // pending | active | ended
  consentAt  DateTime?
  endsAt     DateTime? // the ward's 18th birthday
  createdAt  DateTime  @default(now())

  @@unique([guardianId, wardId])
  @@index([wardId])
}

// Email choices (CASL). Sign-in codes are transactional and always sent.
model EmailPreference {
  patientId        String    @id
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reminders        Boolean   @default(true)
  news             Boolean   @default(false)
  unsubscribeToken String    @unique @default(cuid())
  unsubscribedAt   DateTime?
  updatedAt        DateTime  @updatedAt
}

// "Delete my account": 30-day hold, then a worker erases everything for the patient.
model DeletionRequest {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status       String    @default("pending") // pending | cancelled | running | completed | failed
  reason       String?
  requestedBy  String    @default("patient") // patient | guardian | staff
  requestedAt  DateTime  @default(now())
  scheduledFor DateTime // requestedAt + 30 days
  cancelledAt  DateTime?
  completedAt  DateTime?
  summary      Json? // rows removed per table + files removed (the deletion certificate)

  @@index([status, scheduledFor])
  @@index([patientId])
}

model ExportRequest {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending | ready | expired | failed
  fileKey     String? // object-storage key of the export file
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([patientId, createdAt])
}

// Unified, append-only audit log (replaces AdminAuditEvent + AccessLog writes in Phase 3).
// Never updated or deleted by the app; archived after 7 years.
model AuditEvent {
  id               String   @id @default(cuid())
  at               DateTime @default(now())
  orgId            String?
  actorType        String // staff | patient | guardian | system | device
  actorId          String?
  actorLabel       String? // name/email at the time of the event
  action           String // view | create | update | delete | export | login | logout | send | approve | deny
  resource         String // e.g. "patient.labs", "report"
  subjectPatientId String?
  subjectId        String?
  reason           String? // required for break-glass access
  result           String   @default("success") // success | denied | error
  ip               String?
  meta             Json?

  @@index([at(ops: TimestampMinMaxOps)], type: Brin)
  @@index([subjectPatientId, at])
  @@index([actorId, at])
  @@index([orgId, action, at])
}

// A report sent by staff to a patient (draft → ai_check → review → sent → viewed).
model PatientReport {
  id             String          @id @default(cuid())
  orgId          String
  org            Organization    @relation(fields: [orgId], references: [id])
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documentId     String?
  document       HealthDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title          String
  kind           String          @default("other") // lab | imaging | ecg | letter | summary | other
  status         String          @default("draft") // draft | ai_check | review | sent | viewed | rejected | cancelled
  note           String? // message to the patient
  createdById    String
  createdBy      StaffUser       @relation("ReportCreatedBy", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     StaffUser?      @relation("ReportApprovedBy", fields: [approvedById], references: [id])
  rejectedReason String?
  aiCheck        Json? // name/date-of-birth match + Neyu's reading
  sentAt         DateTime?
  undoUntil      DateTime? // sending can be undone for 10 minutes
  viewedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  deliveries ReportDelivery[]

  @@index([patientId, status, createdAt])
  @@index([orgId, status, createdAt])
  @@index([createdById, status])
}

model ReportDelivery {
  id        String        @id @default(cuid())
  reportId  String
  report    PatientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  channel   String // in_app | email | push
  status    String        @default("queued") // queued | sent | failed | opened
  sentAt    DateTime?
  openedAt  DateTime?
  error     String?
  createdAt DateTime      @default(now())

  @@index([reportId])
  @@index([status, createdAt])
}
