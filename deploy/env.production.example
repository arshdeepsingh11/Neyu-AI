# NEYU Health — production .env (fill on the server; NEVER commit real values)
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://neyuhealth.com
PUBLIC_BASE_URL=https://neyuhealth.com
# PostgreSQL 16 (Phase 2+). connection_limit = connections per app process.
DATABASE_URL="postgresql://neyu:CHANGE_ME@localhost:5432/neyu?schema=public&connection_limit=20"

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Security (generate each with: openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
TOKEN_ENC_KEY=
CRON_SECRET=

# Email (Resend SMTP) — verify neyuhealth.com in Resend first
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=NEYU Health <no-reply@neyuhealth.com>

# Redis — shared rate limits, sign-in guards, cache and the background job queue.
# Install Redis on the server (apt install redis-server) and use the local address.
REDIS_URL=redis://127.0.0.1:6379
# Background worker runs inside the website process. With 2+ web servers set RUN_WORKER=0
# on them and run `npm run worker` on one machine instead.
RUN_WORKER=1

# File storage for patient reports and data exports (encrypted with TOKEN_ENC_KEY).
# Use an absolute path on a disk that is backed up every night. Never inside the app folder.
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/neyu/storage
# Later (S3-compatible storage): STORAGE_DRIVER=s3 + S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY

# Patient sign-up open (true/false)
PORTAL_SIGNUP_OPEN=true

# Optional wearables (leave empty until keys exist)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
IOS_SHORTCUT_URL=
