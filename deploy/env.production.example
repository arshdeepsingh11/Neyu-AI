# NEYU Health — production .env (fill on the server; NEVER commit real values)
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_SITE_URL=https://neyuhealth.com
PUBLIC_BASE_URL=https://neyuhealth.com
# PostgreSQL 16 (Phase 2+). connection_limit = connections per app process (PM2 copies ×
# connection_limit must stay well under max_connections in deploy/postgresql-neyu.conf).
DATABASE_URL="postgresql://neyu:CHANGE_ME@localhost:5432/neyu?schema=public&connection_limit=10&pool_timeout=20"

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Security (generate each with: openssl rand -hex 32)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
TOKEN_ENC_KEY=
CRON_SECRET=

# Email (Resend SMTP) — verify neyuhealth.com in Resend first
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=NEYU Health <no-reply@neyuhealth.com>

# Super admin (owner account). Works even if every other account is lost; managed only here.
# Use a long password in production and turn on the 2-step code.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=NEYU Super Admin
SUPER_ADMIN_2STEP=on

# Redis — shared rate limits, sign-in guards, cache and the background job queue.
# Install Redis on the server (apt install redis-server) and use the local address.
REDIS_URL=redis://127.0.0.1:6379
# Background worker runs inside the website process. With 2+ web servers set RUN_WORKER=0
# on them and run `npm run worker` on one machine instead.
RUN_WORKER=1

# Performance (Phase 5). Copies of the app on this machine (PM2 cluster): "max" = one per
# CPU core. Needs REDIS_URL above. Read by deploy/ecosystem.config.js when PM2 starts.
NEYU_INSTANCES=max
# Monitoring: GET /api/v1/metrics with "Authorization: Bearer <METRICS_TOKEN>" (openssl rand -hex 32).
# Leave empty to switch the endpoint off. /api/v1/health needs no token.
METRICS_TOKEN=

# File storage for patient reports and data exports (encrypted with TOKEN_ENC_KEY).
# Use an absolute path on a disk that is backed up every night. Never inside the app folder.
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/neyu/storage
# Later (S3-compatible storage): STORAGE_DRIVER=s3 + S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY

# Patient sign-up open (true/false)
PORTAL_SIGNUP_OPEN=true

# Optional wearables (leave empty until keys exist)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
IOS_SHORTCUT_URL=
